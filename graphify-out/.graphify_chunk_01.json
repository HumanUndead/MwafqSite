{"nodes":[{"id":"agents_md","label":"AGENTS.md — Agent Execution Rules","file_type":"document","source_file":"AGENTS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"claude_md","label":"CLAUDE.md — Project Map & Conventions","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"readme_md","label":"README.md — Getting Started","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"skill_add_feature_module","label":"Skill: add-feature-module","file_type":"document","source_file":".claude/skills/add-feature-module/SKILL.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"skill_add_i18n_key","label":"Skill: add-i18n-key","file_type":"document","source_file":".claude/skills/add-i18n-key/SKILL.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"skill_add_localized_route","label":"Skill: add-localized-route","file_type":"document","source_file":".claude/skills/add-localized-route/SKILL.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"skill_project_map","label":"Skill: project-map","file_type":"document","source_file":".claude/skills/project-map/SKILL.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"skill_ui_ux","label":"Skill: ui-ux","file_type":"document","source_file":".claude/skills/ui-ux/SKILL.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"demo_index_html","label":"Demo Reference: Home Page (index.html)","file_type":"document","source_file":"demo-reference/Mwafq-Website-Demo/index.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"demo_about_html","label":"Demo Reference: About Us Page","file_type":"document","source_file":"demo-reference/Mwafq-Website-Demo/about-us.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"demo_b2b_html","label":"Demo Reference: B2B Portal Page","file_type":"document","source_file":"demo-reference/Mwafq-Website-Demo/B2B-Portal.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"docs_styling_motion","label":"Styling and Motion Guide","file_type":"document","source_file":"docs/styling-and-motion.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"concept_nextjs16_app_router","label":"Next.js 16 App Router Pattern","file_type":"rationale","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Pages under src/app/[locale]/ stay thin — they read params, fetch, then delegate to modules. This keeps routing infrastructure separate from feature logic."},{"id":"concept_feature_module_convention","label":"Feature Module Convention","file_type":"rationale","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Modules under src/modules/<feature>/ separate domain/types, app/hooks/server, infrastructure/api, and presentation/components. Prevents mixing business logic with UI."},{"id":"concept_i18n_system","label":"i18n Dual-Locale System (en/ar)","file_type":"rationale","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"en.ts is the source of truth. Dictionary type derived via DeepWiden. ar.ts overrides partial keys; missing keys fall back to en via deep merge. RTL handled via isRtl() + html dir attribute."},{"id":"concept_routing_model","label":"Localized Routing Model","file_type":"rationale","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"All routes under src/app/[locale]/. Locale prefix injected by middleware. Hrefs built with getLocalizedRoute() + ROUTES constant — never hardcoded — to prevent broken links across locales."},{"id":"concept_auth_cookies","label":"Auth Cookie Strategy (token + mwafq-session)","file_type":"rationale","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"token is httpOnly:false so client http can attach Bearer. mwafq-session is httpOnly:true for security. Both set together on login, cleared on logout. Proxy treats either presence as authenticated."},{"id":"concept_data_flow","label":"Client-Server Data Flow Pattern","file_type":"rationale","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Client calls local app/api routes via http wrapper (auto-attaches Bearer). Server services call upstream productionapi.mwafq.com directly. Separates client-facing API surface from upstream integration."},{"id":"concept_tailwind_framer_motion","label":"Tailwind + Framer Motion Styling Rule","file_type":"rationale","source_file":"docs/styling-and-motion.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Tailwind for all UI chrome. Framer Motion for all animation. No CSS modules for ordinary chrome. ScrollReveal shared component for reveal-on-view patterns to avoid duplication."},{"id":"concept_rtl_support","label":"RTL (Arabic) Logical Utility Rule","file_type":"rationale","source_file":".claude/skills/ui-ux/SKILL.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Use logical Tailwind utilities (ps-*, pe-*, ms-*, me-*, start-*, end-*) instead of directional ones (pl-*, pr-*, left-*, right-*) so layout works in both LTR and RTL without duplication."},{"id":"concept_design_tokens","label":"Mwafq Brand Design Tokens","file_type":"rationale","source_file":".claude/skills/ui-ux/SKILL.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Brand colors (#1e2364 sapphire, #00a8f1 accent sky, #6b7196 muted) used as hex arbitrary values in Tailwind. No theme config yet. shadcn uses OKLCH tokens — do not mix the two systems in one component."},{"id":"concept_component_libraries","label":"Two-Library Component Strategy","file_type":"rationale","source_file":".claude/skills/ui-ux/SKILL.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Custom shared components (@/shared/components/ui) for brand product UI. shadcn primitives (@/components/ui) for primitives not in shared set. Never mix button systems in one component."},{"id":"concept_scroll_reveal","label":"ScrollReveal Shared Animation Component","file_type":"rationale","source_file":"docs/styling-and-motion.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Centralizes intersection-observer reveal + window.load-delay + reduced-motion support. Prevents duplication of reveal logic across feature components."},{"id":"concept_server_client_boundary","label":"Server-Only / Client Boundary Rule","file_type":"rationale","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Server files start with import 'server-only'. Client components use 'use client'. Files shared between both use *.shared.ts naming and no server-only imports."},{"id":"concept_architecture_priority","label":"Architecture-Over-Brevity Priority","file_type":"rationale","source_file":"AGENTS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"When conflict occurs between clean architecture and shorter code, architecture wins. Prevents short-term shortcuts that break modularity or create technical debt."},{"id":"src_app_locale","label":"src/app/[locale]/ — Route Entry Points","file_type":"code","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"src_modules","label":"src/modules/ — Feature Modules","file_type":"code","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"src_shared","label":"src/shared/ — Cross-Feature Shared Code","file_type":"code","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"src_components_ui","label":"src/components/ui/ — shadcn Primitives","file_type":"code","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"src_i18n","label":"src/i18n/ — Locale Config & Helpers","file_type":"code","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"src_locales_en","label":"src/locales/en.ts — English Dictionary (source of truth)","file_type":"code","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"src_locales_ar","label":"src/locales/ar.ts — Arabic Dictionary","file_type":"code","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"src_proxy","label":"src/proxy.ts — Middleware (locale + auth gating)","file_type":"code","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"src_shared_lib_http","label":"src/shared/lib/http.ts — HTTP Client","file_type":"code","source_file":"